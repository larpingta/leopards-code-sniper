        if q:find("income", 1, true) then return "950K", "hard-lore" end
        if q:find("based", 1, true) or q:find("curry", 1, true) then return "STEPHENCURRY", "hard-lore" end
        if q:find("movie", 1, true) then return "WILLHARRIS", "hard-lore" end
        if q:find("event", 1, true) or q:find("bruno", 1, true) then return "BRUNOMARS", "hard-lore" end
    end
    if (q:find("admin", 1, true) and q:find("war", 1, true)) or q:find("abuse war", 1, true) then
        if q:find("who won", 1, true) or q:find("winner", 1, true) then return "JANDEL", "hard-lore" end
        if q:find("when", 1, true) or q:find("date", 1, true) then return "AUGUST232025", "hard-lore" end
    end
    if q:find("best trait", 1, true) then return "STRAWBERRY", "hard-lore" end
    if q:find("launch", 1, true) and (q:find("game", 1, true) or q:find("sab", 1, true)) then
        return "MAY162025", "hard-lore"
    end
    if q:find("taco tuesday", 1, true) and (q:find("time", 1, true) or q:find("when", 1, true)) then
        return "6PMEST", "hard-lore"
    end

    local mem = memoryLookup(question)
    if mem and mem ~= "" then
        local a = upperCleanLocal(mem)
        if a ~= "" then return a, "live-memory" end
    end
    return nil
end

